# Configure a connection string PostgreSQL do Supabase somente no .env local.
DATABASE_URL=
SUPABASE_URL=
# Segredo exclusivo do backend; nunca configure na Vercel nem em VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
# O bucket deve ser criado manualmente e configurado como privado.
SUPABASE_STORAGE_BUCKET=

# Configuração local. Em Render, use DEBUG=False, uma chave forte e os
# domínios exatos da API e do frontend nas variáveis de origem/host.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Cookies locais. Para frontend e API em sites diferentes, use None e True.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Render termina TLS no proxy e encaminha X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=
SECURE_SSL_REDIRECT=False
